<?xml version="1.0"?>
<odoo>
    <data noupdate="0">

        <record model="ir.module.category" id="module_category_contract" >
            <field name="name">Contract</field>
            <field name="description">Manage contract for contacts</field>
        </record>
        
        <record id="group_consultation_user" model="res.groups">
            <field name="name">Consultation</field>
            <field name="category_id" ref="module_category_contract" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>  

        <record id="group_admin_user" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_contract" />
            <field name="implied_ids" eval="[(4, ref('group_consultation_user'))]"/>
        </record>

        <record model="ir.rule" id="contract_shared_rule">
            <field name="name">Contract Multi-Company</field>
            <field name="model_id" ref="model_contacts_contract_contract"/>
            <field name="global" eval="True"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>
        
    </data>   
</odoo>